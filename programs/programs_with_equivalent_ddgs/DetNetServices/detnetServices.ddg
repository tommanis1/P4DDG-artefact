MyParser = 
    hdr.ethernet
    case hdr.ethernet.etherType of
        %TYPE_DETNET -> hdr.detnetInd if [hdr.detnetInd.proto_id == TYPE_IPV4] then Ipv4() else ()%
        %TYPE_MYTUNNEL -> hdr.myTunnel if [hdr.myTunnel.proto_id == TYPE_IPV4] then Ipv4() else ()  %
        % _ -> () %
    $
Ipv4 = 
    hdr.ipv4
    {verify(hdr.ipv4.ihl >= 5, error.IPHeaderTooShort);}
    if [hdr.ipv4.ihl == 5] then ()
    else (
        hdr.ipv4_option
        if [hdr.ipv4_option.option == IPV4_OPTION_MRI] then 
            hdr.mri
            {meta.parser_metadata.remaining = hdr.mri.count;}
            if [meta.parser_metadata.remaining == 0 ]then ()
            else SWTRACE()

        else 
            ()
    )
    $

SWTRACE() = 
    hdr.swtraces.next
    {meta.parser_metadata.remaining = meta.parser_metadata.remaining  - 1;}
    if[ meta.parser_metadata.remaining == 0] then ()
    else SWTRACE()
    $
